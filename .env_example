# SECURITY WARNING: Keep the secret key used in production secret!
SECRET_KEY=django-insecure-test-key-for-local-development-only

# Django Debug & Security
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL is required)
DATABASE_NAME=eco_libra_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# SMTP Email Configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Google OAuth 2 Configuration

GOOGLE_OAUTH2_KEY=your_key
GOOGLE_OAUTH2_SECRET=your_secret